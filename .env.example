# 쓰기 권한 비밀번호 (필수)
TIL_PASSWORD=change-me

# 세션 서명 키 (선택). 비워두면 비밀번호에서 파생한다.
# openssl rand -base64 32
SESSION_SECRET=

# Turso 접속 정보. 둘 다 비우면 로컬 SQLite 파일(til.db)을 쓴다.
TURSO_DATABASE_URL=libsql://til-benelog.turso.io
TURSO_AUTH_TOKEN=

# 로컬 개발에서 http 로 붙을 때만 사용 (쿠키 Secure 플래그 해제)
# INSECURE_COOKIES=1
