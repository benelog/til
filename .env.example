# 쓰기 권한 비밀번호 (필수)
TIL_PASSWORD=change-me

# 세션 서명 키. 반드시 채운다.
# 비워두면 비밀번호에서 파생하는데, 쿠키에는 만료시각이 평문으로 들어 있어서
# 쿠키 한 장만 유출돼도 비밀번호를 오프라인으로 대입할 수 있다.
# openssl rand -base64 32
SESSION_SECRET=

# 세션 에폭 (선택, 기본 1). 쿠키가 유출됐을 때 숫자를 올리면 이미 나간 세션이
# 전부 무효가 된다. 서버에 세션을 저장하지 않으므로 이것이 유일한 회수 수단이다.
# SESSION_EPOCH=1

# Turso 접속 정보. 둘 다 비우면 로컬 SQLite 파일(til.db)을 쓴다.
TURSO_DATABASE_URL=libsql://til-benelog.turso.io
TURSO_AUTH_TOKEN=

# 로컬 개발에서 http 로 붙을 때만 사용 (쿠키 Secure 플래그 해제)
# INSECURE_COOKIES=1
